<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- This repo version -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <PreReleaseVersionLabel>beta</PreReleaseVersionLabel>
  </PropertyGroup>
  <!--Package versions-->
  <PropertyGroup>
    <MicrosoftNETILLinkTasksVersion>11.0.0</MicrosoftNETILLinkTasksVersion>
    <MicrosoftNETILLinkPackageVersion>11.0.0-rtm.26524.110</MicrosoftNETILLinkPackageVersion>
    <SystemThreadingChannelsPackageVersion>11.0.0</SystemThreadingChannelsPackageVersion>
    <MicrosoftExtensionsLoggingPackageVersion>11.0.0</MicrosoftExtensionsLoggingPackageVersion>
    <BenchmarkDotNetVersion Condition="'$(BenchmarkDotNetVersion)' == ''">0.16.0-nightly.20260801.595</BenchmarkDotNetVersion>
    <!-- Keep older measurements on their existing runner; net12 requires the new runtime model. -->
    <BenchmarkDotNetNet12Version>0.16.0-nightly.20261014.649</BenchmarkDotNetNet12Version>
    <BenchmarkDotNetVersion Condition="$(PERFLAB_TARGET_FRAMEWORKS.Contains('net12.0'))">$(BenchmarkDotNetNet12Version)</BenchmarkDotNetVersion>
    <MicrosoftNETRuntimeEmscripten3156Nodewinx64Version>11.0.0-preview.5.26261.101</MicrosoftNETRuntimeEmscripten3156Nodewinx64Version>
    <MicrosoftDotNetXHarnessCLIVersion>11.0.0-prerelease.26526.1</MicrosoftDotNetXHarnessCLIVersion>
  </PropertyGroup>
  <!--Package names-->
